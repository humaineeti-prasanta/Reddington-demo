# @dpdp/consent-sdk integration. Copy to client/.env.local and fill from
# your DPDP admin panel. VITE_* vars are exposed to the browser at build time
# — the DPDP api key is a publishable client credential (SDK KB §13), not an
# admin key.

VITE_DPDP_TENANT_ID=org_replace_me
VITE_DPDP_APPLICATION_ID=app_replace_me
VITE_DPDP_API_KEY=dpdp_live_replace_me
VITE_DPDP_BASE_URL=http://localhost:3000
VITE_DPDP_SDK_URL=http://localhost:3000/sdk/v1/dpdp-sdk.min.js

# Screen codes published on the DPDP admin panel.
VITE_DPDP_SIGNUP_SCREEN=SCR-SIGNUP
VITE_DPDP_BANNER_SCREEN=SCR-BANNER
VITE_DPDP_PREFCENTER_SCREEN=SCR-PREFCENTER

# Optional per-purpose JIT screens. If unset, ConsentPrompt falls back to
# showPreferenceCenter for that JIT moment.
VITE_DPDP_JIT_RECS_SCREEN=
VITE_DPDP_JIT_NOTIFS_SCREEN=
VITE_DPDP_JIT_EMAILS_SCREEN=
VITE_DPDP_JIT_LOCATION_SCREEN=
VITE_DPDP_JIT_ANALYTICS_SCREEN=
